{
  "manifest_version": 3,
  "name": "Bingers Scrobbler",
  "version": "0.5.1",
  "description": "Marks what you watch on Netflix, Prime Video, Disney+, Max or any site you add as watched on Bingers. Unofficial.",
  "homepage_url": "https://github.com/siklevis7/scrobbler-for-bingers",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Bingers Scrobbler",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms", "notifications", "scripting", "activeTab"],
  "host_permissions": ["https://api.bingers.app/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["content/parse.js", "content/common.js", "content/sites/netflix.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.primevideo.com/*",
        "https://www.amazon.com/*",
        "https://www.amazon.co.uk/*",
        "https://www.amazon.de/*",
        "https://www.amazon.fr/*",
        "https://www.amazon.it/*",
        "https://www.amazon.es/*",
        "https://www.amazon.ca/*",
        "https://www.amazon.com.au/*",
        "https://www.amazon.co.jp/*",
        "https://www.amazon.in/*",
        "https://www.amazon.com.br/*",
        "https://www.amazon.com.mx/*",
        "https://www.amazon.nl/*"
      ],
      "js": ["content/parse.js", "content/common.js", "content/sites/prime.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.disneyplus.com/*"],
      "js": ["content/parse.js", "content/common.js", "content/sites/disney.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://play.max.com/*", "https://play.hbomax.com/*"],
      "js": ["content/parse.js", "content/common.js", "content/sites/max.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://tv.apple.com/*",
        "https://www.hulu.com/*",
        "https://www.paramountplus.com/*",
        "https://www.peacocktv.com/*"
      ],
      "js": ["content/parse.js", "content/common.js", "content/sites/generic.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://tv.apple.com/*",
        "https://www.hulu.com/*",
        "https://www.paramountplus.com/*",
        "https://www.peacocktv.com/*"
      ],
      "js": ["content/page-probe.js"],
      "all_frames": true,
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
